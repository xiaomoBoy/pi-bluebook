[0.017, "o", "\u001b[?2026h\u001b[3;1H\u001b[K\u001b[4;2HVienna once had a wall made partly from\u001b[Ccaptured Ottoman gravestones. After    \u001b[5;1H\u001b[K\u001b[Cthe failed Ottoman siege of 1529, some tombstones were reportedly reused to    \u001b[6;1H\u001b[K\u001b[Cstrengthen city defenses—an eerie example of the city recycling the physical   \u001b[7;1H\u001b[K\u001b[Ctraces of its enemies.                 \r\n\u001b[K\r\n\u001b[48;2;33;59;73m                                                                                \u001b[49m\u001b[10;1H\u001b[K\u001b[48;2;33;59;73m \u001b[38;2;222;224;225mWhat's the story behind the Sachertorte?\u001b[39m                                       \u001b[49m\u001b[11;1H\u001b[K\u001b[48;2;33;59;73m                                                                                \u001b[49m\u001b[12;1H\u001b[K\u001b[13;2H\u001b[38;2;167;152;215mTasks (5 live, /tasks to hide)\u001b[39m         \r\n\u001b[K\u001b[1;60H\u001b[?2026l\u001b[?2026h\u001b[14;2H\u001b[38;2;157;165;169m \u001b[?69h\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[?1006l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[1;1H\u001b[1;24r\u001b[1;24r\u001b[s\u001b[14;3H\u001b[38;2;157;165;169m vacation.research #12: running deliver [background] owns conversation 13\u001b[39m     \u001b[15;1H\u001b"]
