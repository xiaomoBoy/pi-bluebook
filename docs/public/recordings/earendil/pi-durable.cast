[0.002, "o", "\u001b[?2026h\u001b[3;24r\u001b[3;1H\u001b[J\u001b[Cbudget and interests—art, history, food, classical music, nightlife, or        \u001b[4;2Hsomething else?    \u001b[6;1H\u001b[48;2;33;59;73m                                                                                \u001b[7;1H \u001b[38;2;222;224;225mTell me a historical fact about Vienna that few people know.\u001b[39m                   \u001b[8;1H                                                                                \u001b[10;2H\u001b[49mVienna once had a wall made partly from\u001b[Ccaptured Ottoman gravestones. After    \u001b[11;2Hthe failed Ottoman siege of 1529, some tombstones were reportedly reused to    \u001b[12;2Hstrengthen city defenses—an eerie example of the city recycling the physical   \u001b[13;2Htraces of its enemies.                 \u001b[1;24r\u001b[1;60H\u001b[?2026l\u001b[?2026h\u001b[15;2H\u001b[38;2;167;152;215mTasks (3 live, /tasks to hide)\u001b[39m         \u001b[16;2H\u001b[38;2;157;165;169m  vacation.research #12: running deliver [background] owns conversation 13\u001b[39m     \u001b[17;2H\u001b[38;2;157;165;169m    pi.generation #21: waiting on 26, 27, 28"]
