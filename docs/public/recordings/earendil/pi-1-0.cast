[43.858779, "o", "\u001b[?2026h\u001b[1;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[2;1H\u001b[2K\u001b[48;2;37;65;49m                                                                                \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[3;1H\u001b[2K\u001b[48;2;37;65;49m \u001b[38;2;222;224;225m\u001b[1mcodemode\u001b[22m\u001b[39m                                                                       \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[4;1H\u001b[2K\u001b[48;2;37;65;49m \u001b[38;2;105;173;208mconst\u001b[39m r = \u001b[38;2;105;173;208mawait\u001b[39m tools.bash({\u001b[38;2;93;179;186mcommand\u001b[39m: \u001b[38;2;222;141;90m\"rg -n -i \\\"virtual model|virtual         \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[5;1H\u001b[2K\u001b[48;2;37;65;49m \u001b[38;2;222;141;90mmodels|virtual-model\\\" packages/coding-agent/docs                              \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[6;1H\u001b[2K\u001b[48;2;37;65;49m \u001b[38;2;222;141;90mpackages/coding-agent/examples\"\u001b[39m, \u001b[38;2;93;179;186mtimeout\u001b[39m: \u001b[38;2;104;183;141m20000\u001b[39m});                             \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[7;1H\u001b[2K\u001b[48;2;37;65;49m text(r.output);                                                                \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[8;1H\u001b[2K\u001b[48;2;37;65;49m                                  "]
[43.85879, "o", "                                              \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[9;1H\u001b[2K\u001b[48;2;37;65;49m \u001b[38;2;104;183;141m✓\u001b[39m \u001b[38;2;222;224;225mbash\u001b[39m \u001b[38;2;157;165;169m{\"command\":\"rg -n -i \\\"virtual model|virtual models|virtual-model\\\"     \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[10;1H\u001b[2K\u001b[48;2;37;65;49m \u001b[38;2;157;165;169mpackages/...\u001b[39m \u001b[38;2;126;136;142m15ms\u001b[39m                                                              \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[11;1H\u001b[2K\u001b[48;2;37;65;49m                                                                                \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[12;1H\u001b[2K\u001b[48;2;37;65;49m \u001b[38;2;157;165;169mpackages/coding-agent/docs/virtual-models.md:1:# Virtual Models\u001b[39m                \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[13;1H\u001b[2K\u001b[48;2;37;65;49m \u001b[38;2;157;165;169mpackages/coding-agent/docs/virtual-models.md:3:A virtual model is a selectable \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[14;1H\u001b[2K\u001b[48;2;37;65;49m \u001b[38;2;157;165;169mmodel that picks a physical model for each request. Use one to route by task,  \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[15;1H\u001b[2K\u001b[48;2;37;65;49m \u001b[38;2;157;165;169mcost, "]
[43.858805, "o", "or conversation state. For example, a router can send quick questions to \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[16;1H\u001b[2K\u001b[48;2;37;65;49m \u001b[38;2;157;165;169ma small model and hard problems to a large one, while the user selects a       \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[17;1H\u001b[2K\u001b[48;2;37;65;49m \u001b[38;2;157;165;169m... (71 more lines,\u001b[39m \u001b[38;2;126;136;142mctrl+o\u001b[39m\u001b[38;2;157;165;169m to expand\u001b[39m\u001b[38;2;157;165;169m)\u001b[39m                                          \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[18;1H\u001b[2K\u001b[48;2;37;65;49m                                                                                \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[20;1H\u001b[2K\u001b[38;2;97;133;204m── \u001b[39m\u001b[38;2;97;133;204m⠴\u001b[39m \u001b[38;2;97;133;204mWorking\u001b[39m\u001b[38;2;97;133;204m ───────────────────────────────────────────────────────────────────\u001b[39m\u001b[0m\u001b]8;;\u0007\u001b[24;1H\u001b[2K\u001b[38;2;126;136;142m↑12 ↓2.1k R20k W8.0k CH96.9% $0.002 0.9%/1.1M (auto)\u001b[39m\u001b[38;2;126;136;142m         gpt"]
