[43.451851, "o", "8;;\u0007\u001b[9;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[10;1H\u001b[2K\u001b[48;2;33;59;73m                                                                                \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[11;1H\u001b[2K\u001b[48;2;33;59;73m \u001b[38;2;222;224;225mBuild yourself an extension in ~/.pi/agent/extensions/router.ts that registers \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[12;1H\u001b[2K\u001b[48;2;33;59;73m \u001b[38;2;222;224;225ma virtual model router/auto. Plan on radius/claude-opus-5-5. On each new user  \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[13;1H\u001b[2K\u001b[48;2;33;59;73m \u001b[38;2;222;224;225mmessage, ask the Jev classifier whether we moved from planning to              \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[14;1H\u001b[2K\u001b[48;2;33;59;73m \u001b[38;2;222;224;225mimplementation. Once it says yes, switch to radius/gpt-6-luna for good and     \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[15;1H\u001b[2K\u001b[48;2;33;59;73m \u001b[38;2;222;224;225mctx.ui.notify() about it. Read the virtual model docs first.\u001b[39m                   \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[16;1H\u001b[2K\u001b[48;2;33;59;73m                                                                                \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[17;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[18;1H\u001b[2K \u001b[3m\u001b[38;2;15"]
